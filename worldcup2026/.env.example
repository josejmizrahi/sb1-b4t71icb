# ============================================================================
#  World Cup 2026 Predictor - configuration
#  Copy this file to ".env" and fill in your keys. NEVER commit the real .env.
# ============================================================================

# ---- Data provider selection --------------------------------------------
# Which backend to use for fixtures/results/standings.
#   football-data   -> football-data.org (FREE, includes World Cup, NO xG)
#   openfootball    -> openfootball public-domain JSON (FREE, NO key, NO xG)
#   balldontlie     -> BALLDONTLIE FIFA (PAID ~$10/mo after 48h trial, HAS xG)
#   api-football    -> API-Football (PAID, xG + lineups + match stats)   [TODO]
#   sportmonks      -> Sportmonks All-In (PAID, xG + lineups + stats)    [TODO]
#   mock            -> offline synthetic dataset (for dev / tests / demo)
DATA_PROVIDER=football-data

# ---- API keys (read from env, never hardcoded) --------------------------
# football-data.org free tier key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# openfootball needs NO key (public domain).

# BALLDONTLIE FIFA key: https://www.balldontlie.io/  (cheapest xG source)
BALLDONTLIE_API_KEY=

# Only needed if DATA_PROVIDER=api-football
API_FOOTBALL_KEY=

# Only needed if DATA_PROVIDER=sportmonks
SPORTMONKS_API_TOKEN=

# ---- Persistence --------------------------------------------------------
# sqlite (default) or supabase
STORAGE_BACKEND=sqlite
SQLITE_PATH=worldcup2026.db

# Only needed if STORAGE_BACKEND=supabase  [TODO: not yet implemented]
SUPABASE_URL=
SUPABASE_KEY=

# ---- Pipeline ------------------------------------------------------------
# How often the auto-training pipeline polls the API (hours).
POLL_INTERVAL_HOURS=6
# Monte Carlo simulations per match.
MC_SIMULATIONS=50000
